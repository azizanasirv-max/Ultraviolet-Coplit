# ULTRAVOX_API_KEY: Required for Ultravox call creation.
# Set your Ultravox API key here or in the runtime environment.
ULTRAVOX_API_KEY="MY_ULTRAVOX_API_KEY"

# APP_URL: The public URL where this applet is published (used to build
# customer invitation links for Prototype 2). Do not point this at the
# AI Studio `ais-dev-*` preview host, which requires a Google sign-in.
# Example: APP_URL="https://ultraviolet-copilot.onrender.com"
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Peer-to-peer call (salesperson <-> customer) ICE configuration
# ---------------------------------------------------------------------------
# The human-to-human audio call is a direct WebRTC connection. STUN alone only
# works when both devices can reach each other directly; when either side is
# behind a symmetric / carrier-grade NAT (typically a phone on mobile data) no
# path exists, media never flows, and BOTH participants hear nothing even
# though signaling and the AI text pipeline keep working. Set TURN_URLS to a
# TURN relay to make the call work across those networks.
#
# TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
# TURN_USERNAME="turn-user"
# TURN_CREDENTIAL="turn-password"
# STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# ICE_TRANSPORT_POLICY: "all" (default) or "relay" to force all media through
# the TURN relay. Relay-only requires TURN_URLS to be set.
# ICE_TRANSPORT_POLICY="all"

# MAX_SESSIONS: In-memory session cap (default 500). Sessions are not persisted;
# a restart destroys them. See docs/prototype2-architecture.md.
# MAX_SESSIONS="500"
