{
  "name": "ultraviolet-copilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:turn && npm run test:rstream && npm run test:rstream-static && npm run test:expressturn && npm run test:signaling && npm run test:negotiation && npm run test:customer && npm run test:ai && npm run test:audio && npm run test:microphone",
    "test:unit": "node --import tsx --test tests/sessionStore.test.ts",
    "test:audio": "node --import tsx --test tests/audioDiagnostics.test.ts",
    "test:microphone": "node --import tsx --test tests/microphone.test.ts",
    "test:customer": "node --import tsx --test tests/customerMessages.test.ts",
    "test:signaling": "node --import tsx --test tests/signaling.test.ts",
    "test:negotiation": "node --import tsx --test tests/negotiation.test.ts",
    "test:ai": "node --import tsx --test tests/aiSession.test.ts",
    "test:browser": "node --import tsx --test tests/browser-audio.test.ts",
    "test:all": "npm run test && npm run test:browser",
    "start:prod": "NODE_ENV=production tsx server.ts",
    "verify": "npm run lint && npm run test",
    "test:turn": "node --import tsx --test tests/turn.test.ts",
    "test:rstream": "node --import tsx --test tests/rstream.test.ts",
    "test:rstream-static": "node --import tsx --test tests/rstreamStatic.test.ts",
    "test:expressturn": "node --import tsx --test tests/expressTurn.test.ts tests/adminTurn.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "ultravox-client": "^0.6.0",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
